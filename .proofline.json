{
  "version": 1,
  "gates": [
    {
      "name": "go-build-and-focused-tests",
      "command": [
        "sh",
        "-c",
        "go test . ./internal/ui/model -count=1 && go build ./..."
      ],
      "required": true
    }
  ],
  "include": [
    "src/**",
    "app/**",
    "lib/**",
    "cmd/**",
    "internal/**",
    "*.go",
    "*.py",
    "*.ts",
    "*.tsx",
    "*.js",
    "*.jsx",
    "*.json",
    "*.md",
    "*.css",
    "*.html",
    "package.json",
    "package-lock.json",
    "go.mod",
    "go.sum",
    "pyproject.toml",
    "Cargo.toml",
    "Cargo.lock"
  ],
  "deny": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "node_modules/**",
    ".git/**",
    ".harness/**",
    ".pi/**",
    ".omp/**",
    ".supercache/**"
  ],
  "baseBranch": "main",
  "publish": true,
  "allowLocalRemote": false
}
